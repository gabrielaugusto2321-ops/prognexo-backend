# =============================================================================
# Prognexo backend — exemplo de configuração
# Copie para `.env` e preencha. NUNCA versione o `.env` real.
# Em produção, o boot FALHA se faltar qualquer variável marcada [obrigatória em prod].
# =============================================================================

# Ambiente: development | test | production
NODE_ENV=development
PORT=3333
# Nível do logger: fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# -- Supabase --------------------------------------------------------- [obrig. prod]
SUPABASE_URL=https://xxxxx.supabase.co
# Service role: bypassa RLS. SÓ no backend, nunca no frontend.
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# -- IA / embeddings ------------------------------------------------- [obrig. prod]
ANTHROPIC_API_KEY=xxxxx
VOYAGE_API_KEY=xxxxx

# -- Frontend / CORS ------------------------------------------------- [obrig. prod]
# URL pública do frontend (usada em redirects e como origem CORS padrão).
FRONTEND_URL=https://app.exemplo.com
# Allowlist de origens permitidas no CORS (CSV). Sem "*". Se vazio, cai em FRONTEND_URL.
CORS_ALLOWED_ORIGINS=https://app.exemplo.com,https://www.exemplo.com

# -- Topologia ------------------------------------------------------------------
# Nº de instâncias do backend atrás do load balancer. Se > 1 em produção sem um
# store compartilhado de rate-limit (Redis), o boot FALHA de propósito.
APP_INSTANCE_COUNT=1

# -- WhatsApp / Meta ------------------------------------------------- [obrig. prod]
# Você escolhe esta string e cadastra igual no App Dashboard da Meta.
WHATSAPP_VERIFY_TOKEN=escolha-uma-string-secreta
META_APP_ID=000000000000000
# App Secret do app da Meta — usado para validar X-Hub-Signature-256 dos webhooks.
META_APP_SECRET=xxxxx
# Token do usuário de sistema (fallback de envio quando o médico conectou via Embedded Signup).
META_SYSTEM_USER_TOKEN=xxxxx
# 'true' (default) exige assinatura HMAC válida no POST do webhook do WhatsApp.
WHATSAPP_WEBHOOK_SIGNATURE_ENFORCED=true

# -- Google Calendar / OAuth ------------------------------------ [opcional]
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx
GOOGLE_REDIRECT_URI=https://api.exemplo.com/auth/google/callback

# -- Cron externo -------------------------------------------------- [obrig. prod]
# Segredo do job /jobs/limpar-leads-esquecidos (enviado no header, não na URL).
CRON_SECRET=xxxxx

# -- CAPTCHA (signup) -------------------------------------- [obrig. prod: ENABLED=true + SECRET]
# Em produção, se CAPTCHA_ENABLED != 'true' ou faltar CAPTCHA_SECRET, o boot FALHA.
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET=xxxxx

# -- Checkout legado com cartão ----------------------------------------------
# 'false' (default): /planos/assinar responde 503 em produção. PAN/CVV não deve
# trafegar pelo backend — migração para checkout tokenizado Asaas em
# docs/platform/11-asaas-tokenized-checkout-plan.md
LEGACY_CARD_CHECKOUT_ENABLED=false

# -- Asaas (assinaturas) ------------------------------------- [obrig. se checkout ligado]
ASAAS_ENV=sandbox
ASAAS_API_KEY=xxxxx

# -- E-mail transacional -------------------------------------------- [opcional]
RESEND_API_KEY=xxxxx

# -- Webhooks de pagamento --------------------------------------------------------
# Master switch: 'false' (default) => todos os webhooks de pagamento respondem
# 503 em produção. Só ligar após verificar a assinatura de cada provedor contra
# a doc oficial + fixtures reais (ver docs/platform/WEBHOOKS.md).
PAYMENT_WEBHOOKS_ENABLED=false
# 'true' (default) rejeita assinatura inválida quando os webhooks estão ligados.
PAYMENT_WEBHOOKS_ENFORCE_SIGNATURE=true
# Ticto não tem assinatura criptográfica do payload — gate adicional, default 'false'.
TICTO_WEBHOOK_ENABLED=false
# Segredos de verificação por provedor (obrigatórios em prod se ENABLED + ENFORCE).
PAGARME_WEBHOOK_SECRET=xxxxx
KIWIFY_WEBHOOK_SECRET=xxxxx
HOTMART_HOTTOK=xxxxx
TICTO_TOKEN=xxxxx
