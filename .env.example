# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# Voyage AI — embeddings da base de conhecimento (modelo voyage-3.5-lite, 1024 dims)
VOYAGE_API_KEY=xxxxx

# Servidor
PORT=3333

# Webhooks — tokens secretos pra validar origem das chamadas
# WHATSAPP_VERIFY_TOKEN: você escolhe uma string qualquer e cadastra ela
# igual no App Dashboard da Meta (WhatsApp > Configuration > Webhook)
WHATSAPP_VERIFY_TOKEN=escolha-uma-string-secreta-aqui

PAGARME_WEBHOOK_SECRET=xxxxx

# Kiwify: cole esse mesmo valor como query param ?secret=... na URL do webhook,
# em Apps > Webhooks, dentro do painel da Kiwify
KIWIFY_WEBHOOK_SECRET=xxxxx

# Hotmart: o "Hottok" fica em Ferramentas > Webhook, dentro do painel da Hotmart
HOTMART_HOTTOK=xxxxx

# Ticto: o token de conta aparece no próprio payload de todo evento —
# copiar o valor de um evento de teste disparado pelo painel da Ticto
TICTO_TOKEN=xxxxx
