# =============================================================================
# Prognexo backend — exemplo de configuração de STAGING
# Copie para `.env` no ambiente de staging. Apenas PLACEHOLDERS aqui.
# Staging usa credenciais PRÓPRIAS (projeto Supabase de staging, app Meta de
# staging/dev, chaves de sandbox) — NUNCA as de produção.
# O boot FALHA se APP_ENV=staging e alguma URL apontar para um host de PRODUCTION_HOSTS.
# =============================================================================

NODE_ENV=production
APP_ENV=staging
PORT=3333
LOG_LEVEL=info

# Hosts de produção — o boot bloqueia staging que aponte para qualquer um deles.
PRODUCTION_HOSTS=REPLACE_com_hosts_de_producao_separados_por_virgula

APP_INSTANCE_COUNT=1

# Supabase de STAGING (projeto separado do de produção)
SUPABASE_URL=https://REPLACE-staging.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_staging_service_role_key

ANTHROPIC_API_KEY=REPLACE_staging_or_dev_key
VOYAGE_API_KEY=REPLACE_staging_or_dev_key

FRONTEND_URL=https://REPLACE-staging-frontend.example
CORS_ALLOWED_ORIGINS=https://REPLACE-staging-frontend.example

# CAPTCHA de staging (site key/secret de teste do provedor)
CAPTCHA_ENABLED=true
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET=REPLACE_turnstile_test_secret

# WhatsApp / Meta — app de STAGING/DEV, nunca o app de produção em análise.
WHATSAPP_VERIFY_TOKEN=REPLACE_staging_verify_token
META_APP_ID=REPLACE_staging_app_id
META_APP_SECRET=REPLACE_staging_app_secret
META_SYSTEM_USER_TOKEN=REPLACE_staging_system_user_token
WHATSAPP_WEBHOOK_SIGNATURE_ENFORCED=true

# Google — client de STAGING com redirect URI de STAGING (nunca o de produção).
GOOGLE_CLIENT_ID=REPLACE_staging_client_id
GOOGLE_CLIENT_SECRET=REPLACE_staging_client_secret
GOOGLE_REDIRECT_URI=https://REPLACE-staging-api.example/auth/google/callback

CRON_SECRET=REPLACE_staging_cron_secret

# Checkout e webhooks de pagamento: desligados em staging por padrão.
LEGACY_CARD_CHECKOUT_ENABLED=false
PAYMENT_WEBHOOKS_ENABLED=false
PAYMENT_WEBHOOKS_ENFORCE_SIGNATURE=true
TICTO_WEBHOOK_ENABLED=false
ASAAS_ENV=sandbox
ASAAS_API_KEY=REPLACE_asaas_sandbox_key
RESEND_API_KEY=REPLACE_resend_key
PAGARME_WEBHOOK_SECRET=REPLACE
KIWIFY_WEBHOOK_SECRET=REPLACE
HOTMART_HOTTOK=REPLACE
TICTO_TOKEN=REPLACE
